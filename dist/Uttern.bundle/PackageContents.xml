<?xml version="1.0" encoding="utf-8"?>
<ApplicationPackage SchemaVersion="3.0" Version="0.0.0.0" Author="VilhelmH-git"
    ProductCode="5A4CE491-EF7C-42DC-BF9C-3DB49CAC2980"
    Name="Uttern"
    Description="Navisworks to IFC exporter (IFC4 / IFC2x3). A fork of the BIMCamel IFC Exporter (MIT licence).">
  <CompanyDetails Name="VilhelmH-git" Url="https://github.com/VilhelmH-git/bimcamel-ifc-exporter" />

  <!-- One DLL PER RELEASE: a Navisworks plug-in must be compiled against the API of the release it
       runs in (2024 = Api v21, 2025 = v22, 2026 = v23, 2027 = v24). A single DLL built against one
       year loads in the others but its ribbon tab silently fails to register, so each component points
       at its own year folder. Drop the matching per-year build of Uttern.dll into .\2024\, .\2025\,
       .\2026\, .\2027\. -->

  <!-- Navisworks 2027 -->
  <Components Description="2027 Manage">
    <RuntimeRequirements OS="Win64" Platform="NAVMAN" SeriesMin="Nw24" SeriesMax="Nw24" />
    <ComponentEntry AppType="ManagedPlugin" ModuleName=".\2027\Uttern.dll" />
  </Components>
  <Components Description="2027 Simulate">
    <RuntimeRequirements OS="Win64" Platform="NAVSIM" SeriesMin="Nw24" SeriesMax="Nw24" />
    <ComponentEntry AppType="ManagedPlugin" ModuleName=".\2027\Uttern.dll" />
  </Components>

  <!-- Navisworks 2026 -->
  <Components Description="2026 Manage">
    <RuntimeRequirements OS="Win64" Platform="NAVMAN" SeriesMin="Nw23" SeriesMax="Nw23" />
    <ComponentEntry AppType="ManagedPlugin" ModuleName=".\2026\Uttern.dll" />
  </Components>
  <Components Description="2026 Simulate">
    <RuntimeRequirements OS="Win64" Platform="NAVSIM" SeriesMin="Nw23" SeriesMax="Nw23" />
    <ComponentEntry AppType="ManagedPlugin" ModuleName=".\2026\Uttern.dll" />
  </Components>

  <!-- Navisworks 2025 -->
  <Components Description="2025 Manage">
    <RuntimeRequirements OS="Win64" Platform="NAVMAN" SeriesMin="Nw22" SeriesMax="Nw22" />
    <ComponentEntry AppType="ManagedPlugin" ModuleName=".\2025\Uttern.dll" />
  </Components>
  <Components Description="2025 Simulate">
    <RuntimeRequirements OS="Win64" Platform="NAVSIM" SeriesMin="Nw22" SeriesMax="Nw22" />
    <ComponentEntry AppType="ManagedPlugin" ModuleName=".\2025\Uttern.dll" />
  </Components>

  <!-- Navisworks 2024 -->
  <Components Description="2024 Manage">
    <RuntimeRequirements OS="Win64" Platform="NAVMAN" SeriesMin="Nw21" SeriesMax="Nw21" />
    <ComponentEntry AppType="ManagedPlugin" ModuleName=".\2024\Uttern.dll" />
  </Components>
  <Components Description="2024 Simulate">
    <RuntimeRequirements OS="Win64" Platform="NAVSIM" SeriesMin="Nw21" SeriesMax="Nw21" />
    <ComponentEntry AppType="ManagedPlugin" ModuleName=".\2024\Uttern.dll" />
  </Components>

</ApplicationPackage>
